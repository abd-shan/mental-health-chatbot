# OpenRouter / LangChain
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Aoun Mental Health Chatbot

# Runtime mode. Production requires AI_SERVICE_API_KEY.
APP_ENV=development
ENABLE_TEST_UI=true
ENABLE_API_DOCS=true

# Backend-to-AI authentication. Always set a long random value in production.
AI_SERVICE_API_KEY=

# Leave empty for internal service-to-service deployment. The test UI is same-origin.
CORS_ORIGINS=

# Main backend public catalog. Production Compose uses host networking on Linux.
PLATFORM_API_BASE_URL=http://127.0.0.1:3000
PLATFORM_CATALOG_CACHE_TTL_SECONDS=300
PLATFORM_API_TIMEOUT_SECONDS=10
PLATFORM_CATALOG_MAX_ITEMS=100

# In-memory conversation limits for the first phase.
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
